    <TIER ANNOTATOR="Miracle-and-Joy" LANG_REF="und"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="@arh2007m" TIER_ID="text@arh2007m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts17">
                <ANNOTATION_VALUE>если долго заниматься математикой то</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts18" TIME_SLOT_REF2="ts22">
                <ANNOTATION_VALUE>ты начинаешь понимать математику</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts23" TIME_SLOT_REF2="ts32">
                <ANNOTATION_VALUE>а ещё ты начинаешь понимать нравится ли она тебе</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a7"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>#смеётся#</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts35" TIME_SLOT_REF2="ts39">
                <ANNOTATION_VALUE>и мне не понравилась</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts40" TIME_SLOT_REF2="ts41">
                <ANNOTATION_VALUE>#смеётся#</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a11"
                TIME_SLOT_REF1="ts44" TIME_SLOT_REF2="ts50">
                <ANNOTATION_VALUE>ну вообще типа это довольно полезно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts51" TIME_SLOT_REF2="ts58">
                <ANNOTATION_VALUE>нам / учитель часто говорила что ну</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a13"
                TIME_SLOT_REF1="ts59" TIME_SLOT_REF2="ts66">
                <ANNOTATION_VALUE>я вас учу / не просто математике</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts67" TIME_SLOT_REF2="ts72">
                <ANNOTATION_VALUE>а / целому умению думать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts73" TIME_SLOT_REF2="ts78">
                <ANNOTATION_VALUE>ии в целом развиваю ваши</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts79" TIME_SLOT_REF2="ts85">
                <ANNOTATION_VALUE>мм / умственные способности так сказать</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a17"
                TIME_SLOT_REF1="ts86" TIME_SLOT_REF2="ts97">
                <ANNOTATION_VALUE>и в какой-то момент я / заметил что это действительно работает</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts98" TIME_SLOT_REF2="ts111">
                <ANNOTATION_VALUE>и это работает не только с математикой / это и с лингвистикой работает</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts112" TIME_SLOT_REF2="ts118">
                <ANNOTATION_VALUE>да и с любой наверно наукой</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a20"
                TIME_SLOT_REF1="ts119" TIME_SLOT_REF2="ts130">
                <ANNOTATION_VALUE>так что / ну / я не особо жалею об этом</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts131" TIME_SLOT_REF2="ts141">
                <ANNOTATION_VALUE>к тому же у меня друзей много появилось из-за этого</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
